{
  "entities": {
    "doctors": {
      "title": "doctors",
      "description": "Doctor profile and clinic settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "clinicName": { "type": "string" },
        "qrCodeId": { "type": "string" },
        "subscriptionStatus": { "type": "string" },
        "trialEndDate": { "type": "string" },
        "subscriptionEndDate": { "type": "string" },
        "avgConsultTime": { "type": "number" },
        "workHours": {
          "type": "object",
          "properties": {
            "open": { "type": "string" },
            "close": { "type": "string" },
            "maxPatientsPerDay": { "type": "number" }
          }
        },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "specialty"]
    },
    "dailyCounters": {
      "title": "dailyCounters",
      "description": "Daily ticket counter for queue number generation",
      "type": "object",
      "properties": {
        "lastSequenceNumber": { "type": "number" },
        "date": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["lastSequenceNumber", "date"]
    },
    "clinicMembers": {
      "title": "clinicMembers",
      "description": "Clinic members and team roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "organizationId": { "type": "string" },
        "role": { "type": "string", "enum": ["OWNER", "DOCTOR", "SECRETARY", "STAFF"] },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled", "invited"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "invitedBy": { "type": "string" }
      },
      "required": ["uid", "organizationId", "role", "email", "status"]
    },
    "auditLogs": {
      "title": "auditLogs",
      "description": "Audit trail for sensitive clinic organization actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "actorUid": { "type": "string" },
        "action": { "type": "string" },
        "targetUid": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["organizationId", "actorUid", "action", "timestamp"]
    },
    "patients": {
      "title": "queues/{doctorId}/patients",
      "description": "Patients in queue for a doctor",
      "type": "object",
      "properties": {
        "sequenceNumber": { "type": "number" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "calledAt": { "type": "string" },
        "doneAt": { "type": "string" }
      },
      "required": ["sequenceNumber", "name", "phone", "status"]
    },
    "ratings": {
      "title": "ratings",
      "description": "Patient ratings and reviews for doctors",
      "type": "object",
      "properties": {
        "doctorId": { "type": "string" },
        "patientRecordId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "stars": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["doctorId", "patientRecordId", "stars"]
    },
    "followUpAppointments": {
      "title": "followUpAppointments",
      "description": "Follow up appointments for patients with doctors",
      "type": "object",
      "properties": {
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "doctorId": { "type": "string" },
        "clinicId": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "appointmentTime": { "type": "string" },
        "appointmentStatus": { "type": "string" },
        "notes": { "type": "string" },
        "reason": { "type": "string" },
        "reminderSettings": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["patientName", "patientPhone", "doctorId", "appointmentDate", "appointmentTime", "appointmentStatus"]
    }
  },
  "firestore": {
    "doctors/{doctorId}": {
      "schema": "doctors",
      "description": "Doctors collection"
    },
    "queues/{doctorId}/dailyCounters/{dateId}": {
      "schema": "dailyCounters",
      "description": "Daily queue sequence counter for atomic booking"
    },
    "queues/{doctorId}/patients/{patientId}": {
      "schema": "patients",
      "description": "Patient tickets queue"
    },
    "ratings/{ratingId}": {
      "schema": "ratings",
      "description": "Patient doctor ratings and reviews"
    },
    "followUpAppointments/{appointmentId}": {
      "schema": "followUpAppointments",
      "description": "Patient follow-up appointments"
    },
    "clinic_members/{memberId}": {
      "schema": "clinicMembers",
      "description": "Clinic members and staff"
    },
    "organizations/{organizationId}/audit_logs/{logId}": {
      "schema": "auditLogs",
      "description": "Organization membership audit trail"
    }
  }
}
