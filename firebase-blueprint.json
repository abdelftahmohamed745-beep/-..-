{
  "entities": {
    "doctors": {
      "title": "doctors",
      "description": "Doctor profile and clinic settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "clinicName": { "type": "string" },
        "qrCodeId": { "type": "string" },
        "subscriptionStatus": { "type": "string" },
        "trialEndDate": { "type": "string" },
        "subscriptionEndDate": { "type": "string" },
        "avgConsultTime": { "type": "number" },
        "workHours": {
          "type": "object",
          "properties": {
            "open": { "type": "string" },
            "close": { "type": "string" },
            "maxPatientsPerDay": { "type": "number" }
          }
        },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "specialty"]
    },
    "patients": {
      "title": "queues/{doctorId}/patients",
      "description": "Patients in queue for a doctor",
      "type": "object",
      "properties": {
        "sequenceNumber": { "type": "number" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "calledAt": { "type": "string" },
        "doneAt": { "type": "string" }
      },
      "required": ["sequenceNumber", "name", "phone", "status"]
    },
    "ratings": {
      "title": "ratings",
      "description": "Patient ratings and reviews for doctors",
      "type": "object",
      "properties": {
        "doctorId": { "type": "string" },
        "patientRecordId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "stars": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["doctorId", "patientRecordId", "stars"]
    },
    "followUpAppointments": {
      "title": "followUpAppointments",
      "description": "Follow up appointments for patients with doctors",
      "type": "object",
      "properties": {
        "patientName": { "type": "string" },
        "patientPhone": { "type": "string" },
        "doctorId": { "type": "string" },
        "clinicId": { "type": "string" },
        "appointmentDate": { "type": "string" },
        "appointmentTime": { "type": "string" },
        "appointmentStatus": { "type": "string" },
        "notes": { "type": "string" },
        "reason": { "type": "string" },
        "reminderSettings": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["patientName", "patientPhone", "doctorId", "appointmentDate", "appointmentTime", "appointmentStatus"]
    }
  },
  "firestore": {
    "doctors/{doctorId}": {
      "schema": "doctors",
      "description": "Doctors collection"
    },
    "queues/{doctorId}/patients/{patientId}": {
      "schema": "patients",
      "description": "Patient tickets queue"
    },
    "ratings/{ratingId}": {
      "schema": "ratings",
      "description": "Patient doctor ratings and reviews"
    },
    "followUpAppointments/{appointmentId}": {
      "schema": "followUpAppointments",
      "description": "Patient follow-up appointments"
    }
  }
}
