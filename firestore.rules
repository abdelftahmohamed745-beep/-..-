rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // STRICT CUSTOM CLAIMS ONLY (Requirement 1 & 7)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isValidDoctorUpdate() {
      // Prevent client-side modification of administrative & billing fields
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
        'isAdmin', 
        'isActive', 
        'subscriptionStatus', 
        'subscriptionEndDate', 
        'createdAt', 
        'ownerId'
      ]);
    }

    function isValidPatientCreate() {
      let data = request.resource.data;
      return data.name is string 
        && data.name.size() >= 2 
        && data.name.size() <= 100
        && data.phone is string
        && data.phone.size() >= 8
        && data.phone.size() <= 20
        && data.sequenceNumber is number
        && data.sequenceNumber > 0
        && data.status == 'waiting';
    }

    function isValidPatientUpdate() {
      // Prevent patient from updating server-controlled notification tracking flags
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return !affected.hasAny([
        'notificationSent',
        'notifiedForTwoTurns',
        'notifiedForOneTurn',
        'notifiedForTenMinutes',
        'sequenceNumber',
        'doctorId',
        'clinicId'
      ]);
    }

    // Doctors collection
    match /doctors/{doctorId} {
      // Public directory read allowed for all visitors/patients
      allow read: if true;
      
      // Creation allowed for authenticated self or admin
      allow create: if isOwner(doctorId) || isAdmin();

      // Updates: ONLY owner without protected fields, OR admin
      allow update: if (isOwner(doctorId) && isValidDoctorUpdate()) || isAdmin();

      // Deletion: Restricted strictly to Admin (doctors cannot delete their account directly)
      allow delete: if isAdmin();
    }

    // Queues and Patients subcollection
    match /queues/{doctorId}/patients/{patientId} {
      // Public read: allow patients to track turn in real time
      allow read: if true;

      // Create: Validated ticket creation with required payload fields
      allow create: if isValidPatientCreate();

      // Update: Doctor owner or admin can update; or patient cancelling their ticket
      allow update: if (isOwner(doctorId) && isValidPatientUpdate()) 
        || isAdmin() 
        || (resource.data.phone == request.resource.data.phone && request.resource.data.status == 'cancelled');

      // Delete: Only clinic doctor or admin
      allow delete: if isOwner(doctorId) || isAdmin();
    }

    // User FCM Tokens collection
    match /users/{userId}/fcmTokens/{tokenId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // User Notification Preferences
    match /users/{userId}/settings/notifications {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // User In-App Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, update: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Audit Logs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
